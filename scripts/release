#!/usr/bin/env sh
# Prepare reviewed release metadata; never commit, tag, push or publish.
set -eu
if [ "$#" -ne 1 ]; then
    echo "Usage: scripts/release VERSION (prepares metadata only)" >&2
    exit 2
fi
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
exec python3 "$ROOT/scripts/metadata.py" --version "$1"
