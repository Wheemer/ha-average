#!/usr/bin/env sh
# Create the isolated development environment without reading HA secrets.yaml.
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$ROOT"
python3 -m venv "$ROOT/venv"
"$ROOT/venv/bin/python" -m pip install --upgrade pip
"$ROOT/venv/bin/python" "$ROOT/scripts/install_requirements.py" requirements-dev.txt
"$ROOT/venv/bin/python" -m pre_commit install
